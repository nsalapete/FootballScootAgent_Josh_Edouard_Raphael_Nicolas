# Copier ce fichier en `.env` (`make env`) puis remplir les valeurs. Ne jamais committer `.env`.

# --- Neo4j (depuis la machine ; dans Docker Compose, NEO4J_URI est forcé à bolt://neo4j:7687) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_S=10

# --- Neo4j de test (`make test-db`, port 7688, vidé à chaque lancement des tests) ---
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_PASSWORD=testpassword

# --- API ---
# Clé exigée par les endpoints sensibles (en-tête X-API-Key)
API_KEY=change-me
# Image publiée sur un registre public (rôle B)
API_IMAGE=football-scout-api:dev

# --- LLM ---
# anthropic | openai_compatible | fake (fake = modèle déterministe, aucun appel réseau)
LLM_PROVIDER=anthropic
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-sonnet-5-5
# Pour NanoGPT ou tout fournisseur compatible OpenAI : URL de base de son API
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Données ---
DUCKDB_PATH=data/transfermarkt-datasets.duckdb
DUCKDB_URL=https://pub-e682421888d945d684bcae8890b0ec20.r2.dev/data/transfermarkt-datasets.duckdb
SCOPE_COMPETITIONS=GB1,ES1,IT1,L1,FR1,PO1,NL1
SCOPE_FROM_SEASON=2015

# Role D: require X-API-Key on POST /api/agent/ask (set to true in production, it spends LLM credit)
AGENT_REQUIRE_API_KEY=false
